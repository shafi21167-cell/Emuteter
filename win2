@echo off
title Sadex Beta Android Core Engine

set QEMU_PATH=C:\Program Files\qemu
set PATH=%QEMU_PATH%;%PATH%

cd /d "%~dp0"

echo [Sadex Engine] Booting Installed Android OS...

"%QEMU_PATH%\qemu-system-x86_64.exe" -m 2068 -smp 2 -cpu qemu64 -display sdl -vga std -drive file=android_disk.qcow2,format=qcow2,cache=unsafe,if=virtio -boot c

pause
